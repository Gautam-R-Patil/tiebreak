# MongoDB connection string (MongoDB Atlas recommended for production)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tiebreak?retryWrites=true&w=majority

# Secret used to sign JWT access tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Local API port (only used by `npm run dev:api`)
PORT=5050

# Comma-separated list of allowed browser origins (production only; local dev is proxied)
CORS_ORIGIN=https://your-site.netlify.app
